---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { c, site, icon } from '../lib/site';
---
<Base title="Services" description={`Services from ${c.name}: ${site.services.map((s) => s.title.toLowerCase()).join(', ')}.`} path="/services/">
  <div class="page-head"><div class="wrap">
    <h1>Services</h1>
    <p>Everything from supply to installation and after-sales support.</p>
  </div></div>
  <section>
    <div class="wrap grid">
      {site.services.map((s) => (
        <article class="card">
          <div class="icon" set:html={icon(s.icon)} />
          <h2>{s.title}</h2>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
  </section>
  <Cta />
</Base>
