---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---
<Base title="Page not found" path="/404/" noindex>
  <section>
    <div class="wrap prose">
      <p class="eyebrow">404</p>
      <h1>We couldn’t find that page.</h1>
      <p class="lead">The link may be old or mistyped.</p>
      <div class="actions"><a class="btn primary" href={url('/')}>Back to home</a><a class="btn ghost" href={url('/contact/')}>Contact us</a></div>
    </div>
  </section>
</Base>
