---
import Base from '../layouts/Base.astro';
import { c, site, icon, prettyPhone, telHref, waHref } from '../lib/site';
const key = site.contact.web3formsKey;
---
<Base title="Contact" description={`Contact ${c.name} — call ${prettyPhone(c.phone)}, WhatsApp, email or send an enquiry.`} path="/contact/">
  <div class="page-head"><div class="wrap">
    <h1>Contact us</h1>
    <p>Tell us what you need and we will come back with advice and a quotation. {site.contact.responseTime}</p>
  </div></div>
  <section>
    <div class="wrap contact">
      <div class="info">
        <div class="row"><span class="icon" set:html={icon('phone')} /><div><b>Phone</b><a href={telHref(c.phone)}>{prettyPhone(c.phone)}</a></div></div>
        {c.whatsapp && <div class="row"><span class="icon" set:html={icon('message-circle')} /><div><b>WhatsApp</b><a href={waHref(c.whatsapp, `Hello ${c.name}, I would like to enquire about…`)} rel="noopener">Message us</a></div></div>}
        {c.email && <div class="row"><span class="icon" set:html={icon('mail')} /><div><b>Email</b><a href={`mailto:${c.email}`}>{c.email}</a></div></div>}
        {(c.address || c.mapUrl) && <div class="row"><span class="icon" set:html={icon('map-pin')} /><div><b>Address</b>{c.address}{c.mapUrl && <Fragment> · <a href={c.mapUrl} rel="noopener">Open in Maps</a></Fragment>}</div></div>}
        {c.hours && <div class="row"><span class="icon" set:html={icon('clock')} /><div><b>Hours</b>{c.hours}</div></div>}
      </div>

      {key ? (
        <form id="contact-form" data-reply={site.contact.responseTime} novalidate>
          <input type="hidden" name="access_key" value={key} />
          <input type="hidden" name="subject" value={`New website enquiry — ${c.name}`} />
          <input type="hidden" name="from_name" value={`${c.name} website`} />
          <div class="hp" aria-hidden="true"><label for="botcheck">Leave this empty</label><input id="botcheck" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></div>
          <div class="two">
            <div><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required maxlength="120" /></div>
            <div><label for="phone">Phone</label><input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required maxlength="30" /></div>
          </div>
          <div><label for="email">Email <span class="note">(optional)</span></label><input id="email" name="email" type="email" autocomplete="email" maxlength="160" /></div>
          <div><label for="message">What do you need?</label><textarea id="message" name="message" required maxlength="3000"></textarea></div>
          <p class="note">We use your details only to reply to this enquiry. See our <a href={`${import.meta.env.BASE_URL}privacy/`}>privacy page</a>.</p>
          <button class="btn primary" type="submit">Send enquiry</button>
          <p id="form-status" class="status" role="status" aria-live="polite"></p>
        </form>
        <script src="../scripts/contact.js"></script>
      ) : (
        <div class="fallback">
          <h2>Send us an enquiry</h2>
          <p>The online form is being set up. Meanwhile, please reach us directly:</p>
          <div class="actions">
            <a class="btn primary" href={telHref(c.phone)}>Call {prettyPhone(c.phone)}</a>
            {c.whatsapp && <a class="btn ghost" href={waHref(c.whatsapp)} rel="noopener">WhatsApp</a>}
            {c.email && <a class="btn ghost" href={`mailto:${c.email}`}>Email</a>}
          </div>
        </div>
      )}
    </div>
  </section>
</Base>
