---
import { c, url, prettyPhone, telHref } from '../lib/site';
---
<section class="band">
  <div class="wrap">
    <h2>Need equipment, installation or service?</h2>
    <p>Call us, message us on WhatsApp or send an enquiry — we will get back to you promptly.</p>
    <div class="actions">
      <a class="btn light" href={url('/contact/')}>Send an enquiry</a>
      <a class="btn ghost on-dark" href={telHref(c.phone)}>Call {prettyPhone(c.phone)}</a>
    </div>
  </div>
</section>
